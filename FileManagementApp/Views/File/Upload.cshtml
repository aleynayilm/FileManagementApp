@{
    ViewData["Title"] = "Dosya Yükle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow p-4 mt-4">
            <h3 class="card-title mb-3 text-center">Dosya Yükle</h3>

            <form asp-controller="File" asp-action="Upload" enctype="multipart/form-data" method="post">
                <div class="mb-3">
                    <label class="form-label">Dosya Seç</label>
                    <input type="file" class="form-control" name="file" required />
                </div>
                <button type="submit" class="btn btn-primary w-100">Yükle</button>
            </form>
        </div>
    </div>
</div>
